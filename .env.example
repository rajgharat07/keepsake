# Tiger Data / Timescale Postgres connection string
# Get this from your Tiger Cloud dashboard — never commit the real value.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Optional: Sentry DSN for agent tracing screenshots
SENTRY_DSN=

# Local models (Ollama must already be running)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Person this instance is built for
KEEPSAKE_PERSON_NAME=Dadi
KEEPSAKE_PERSON_RELATION=grandmother
